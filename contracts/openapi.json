  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-sid"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SignInBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "person@example.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CurrentUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "ChangePasswordBody": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password"
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 1024
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "IssueRecoveryCodesBody": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "currentPassword"
        ]
      },
      "RecoveryCodesResponse": {
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "codes"
        ]
      },
      "RecoverWithCodeBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "person@example.com"
          },
          "code": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 1024
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ]
      },
      "HouseholdNameBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "HouseholdResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER",
              "VIEWER"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "MembershipResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER",
              "VIEWER"
            ]
          }
        },
        "required": [
          "userId",
          "role"
        ]
      }
    }
  }

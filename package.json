{
  "name": "prumo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "dev:web": "pnpm --filter prumo-web dev",
    "dev:api": "pnpm --filter prumo-api start:dev",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check \"prumo-api/src/**/*.ts\" \"prumo-api/test/**/*.ts\" \"prumo-web/src/**/*.{ts,tsx,css}\" \"prumo-web/test/**/*.mjs\" \"prumo-web/next.config.ts\" \"scripts/**/*.mjs\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "contract:generate": "pnpm --filter prumo-api build && pnpm --filter prumo-api contract:openapi && node scripts/generate-web-contract.mjs",
    "contract:check": "pnpm --filter prumo-api build && pnpm --filter prumo-api contract:check && node scripts/generate-web-contract.mjs --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10"
  }
}
